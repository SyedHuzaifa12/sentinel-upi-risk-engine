# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
.venv_*/
env/

# Django
backend/db.sqlite3
backend/db.sqlite3.bak
# Only user-uploaded content is ignored -- default.jpg is a required app
# asset (the default avatar), not user data, and must be tracked or a
# fresh checkout (e.g. CI) has no avatar to fall back to at all.
backend/media/profile_images/
backend/static/

# Environment variables / secrets
.env
backend/.env

# Jupyter
.ipynb_checkpoints/
ml/notebooks/.ipynb_checkpoints/

# Editors / OS
.idea/
.vscode/
.DS_Store
*.log
*.pot

# Model artifacts produced by re-running notebooks into the wrong place
ml/notebooks/*.pkl

# Generated synthetic UPI event data (regenerate via ml.src.generator.cli;
# DATA_CARD.md is the only tracked file in this directory)
data/synthetic/*.jsonl
data/synthetic/*.csv

# pytest cache (ml/tests/)
.pytest_cache/

# Session/agent working notes, not project source
CLAUDE.md
PROGRESS.md

# Phase 6: local-file MLflow tracking store (file:./mlruns) -- experiment
# runs/artifacts, not source. Never a server; see pipelines/train.py.
mlruns/

# Phase 6: generated backtest/drift reports -- reproducible outputs, not
# source (unlike ml/artifacts/models/*.pkl and metrics_v2.json, which ARE
# tracked so CI's quality gate has something to read without retraining).
ml/artifacts/backtests/
ml/artifacts/drift/
