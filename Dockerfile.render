# Render deploy target -- a SECOND, ADDED deploy target. The plain
# Dockerfile (docker-compose.yml's build) is untouched and remains the
# primary local-dev image; this is a separate, slimmed single-process image
# for Render's free tier (512MB RAM, 0.1 CPU). See DEPLOY_NOTES.md.
#
# Multi-stage: build tools (build-essential, dev headers) exist only in the
# "builder" stage and never reach the final image -- only the compiled
# packages + the RUNTIME (non-dev) shared libraries they link against ship.

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Build-time only: headers/compilers needed to build cryptography/Pillow
# wheels on slim images (same packages the plain Dockerfile installs).
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libjpeg62-turbo-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# --prefix, not the default site-packages -- this is what lets the final
# stage copy ONLY the installed packages (COPY --from=builder /install
# /usr/local below), never the build toolchain above.
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


FROM python:3.11-slim AS final

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# RUNTIME shared libraries only (no "-dev" headers, no compiler) -- Pillow
# and zlib-linked wheels still need these .so files present to import, even
# though nothing in this stage ever compiles anything.
#
# libgomp1 (2026-08-18, found via a failed Render build): LightGBM's compiled
# extension dynamically links libgomp.so.1 (OpenMP) at import time -- it does
# NOT vendor this inside its wheel, unlike numpy/scipy/pandas, which bundle
# their own OpenBLAS/runtime libs and need nothing extra here. The plain
# Dockerfile (docker-compose target) never hit this because it never strips
# build-essential out of its single stage -- installing gcc pulls in libgomp1
# as an incidental transitive dependency, silently masking the real runtime
# requirement. This multi-stage build correctly strips that accidental
# dependency, which is exactly why the gap became visible instead of staying
# hidden. Audited (not assumed) whether anything else needs a similar add:
# scikit-learn's and shap's compiled extensions can also use OpenMP in some
# builds, but that's the SAME libgomp.so.1, already covered here, not a
# second package. psycopg2-binary/psycopg[binary] vendor libpq inside their
# own wheels (that's what "binary" means). cryptography's OpenSSL need is
# already satisfied by python:3.11-slim's own base packages -- proven by the
# plain Dockerfile using the identical base image successfully today.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libjpeg62-turbo zlib1g libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local

COPY . .

RUN chmod +x render_entrypoint.sh \
    && cd backend && DEBUG=True python manage.py collectstatic --noinput

EXPOSE 8000

CMD ["./render_entrypoint.sh"]
