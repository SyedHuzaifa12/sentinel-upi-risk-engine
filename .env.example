# Copy this file to backend/.env and fill in real values for local development.
# Never commit the real .env file.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=

# Social auth (GitHub OAuth app)
GITHUB_KEY=
GITHUB_SECRET=

# Social auth (Google OAuth app)
GOOGLE_KEY=
GOOGLE_SECRET=

# Email (used for password-reset emails via smtp.gmail.com)
EMAIL_USER=
EMAIL_PASSWORD=

# Optional: override where the trained model artifact is loaded from.
# Defaults to <repo_root>/ml/artifacts/models.
MODEL_ARTIFACT_DIR=
