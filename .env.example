# For local (non-Docker) dev: copy this file to backend/.env.
# For Docker Compose: copy this file to a root-level .env (docker-compose.yml
# reads it automatically for both ${VAR} substitution and container env vars).
# Never commit the real .env file.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=

# Social auth (GitHub OAuth app)
GITHUB_KEY=
GITHUB_SECRET=

# Social auth (Google OAuth app)
GOOGLE_KEY=
GOOGLE_SECRET=

# Email (used for password-reset emails via smtp.gmail.com)
EMAIL_USER=
EMAIL_PASSWORD=

# Optional: override where the trained model artifact is loaded from.
# Defaults to <repo_root>/ml/artifacts/models.
MODEL_ARTIFACT_DIR=

# Optional: URL of the Phase 4 FastAPI scoring service (uvicorn service.main:app).
# Defaults to http://localhost:8001.
RISK_API_URL=

# --- Phase 5: Docker Compose (postgres, redis, api, worker, ui, generator) ---

# Postgres credentials -- used both by docker-compose.yml (to start the
# postgres container) and to build DATABASE_URL for ui/api/worker. Defaults
# below (sentinel/sentinel/sentinel) are dev-only; override for anything
# beyond a local demo.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel

# Optional: Django's DB connection. Unset -> falls back to the local SQLite
# file (used by manage.py test / local dev without Docker). Under Docker
# Compose this is set automatically in docker-compose.yml's `environment:`
# blocks (pointing at the `postgres` service), not read from this file.
DATABASE_URL=

# Used by service/ and worker/ to pick the HistoryStore backend: memory
# (default, no Docker needed) | postgres | redis. docker-compose.yml sets
# this to `redis` for the api/worker services so they share one online store.
STORE_BACKEND=memory

# Optional: seed service/'s store from data/synthetic/events.jsonl at startup
# so demo scoring isn't all-cold. Default off.
SEED_EVENTS=false

# Redis connection for STORE_BACKEND=redis and the worker/ Streams producer +
# consumer. docker-compose.yml sets this to redis://redis:6379/0 for
# api/worker/generator automatically.
REDIS_URL=

# Host-side only (not read by any running service): point these at the
# published ports (localhost:5432 / localhost:6379) to run the Postgres
# parity test and worker/decisionlog integration tests from the `.venv`
# against the Dockerized postgres/redis, e.g.:
#   TEST_DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
#   TEST_REDIS_URL=redis://localhost:6379/1   (db index 1 -- kept separate
#     from the app's own db 0 so tests never collide with real stream data)
TEST_DATABASE_URL=
TEST_REDIS_URL=
